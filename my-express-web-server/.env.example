NODE_ENV=development
PORT=4001

DATABASE_URI=mongodb://<user>:<password>@<host>/<db>

SECRET_KEY=change-me

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me

# Evaluations (ratings) and solar logs (activity logs) are forwarded here so they still
# land in the arecgis admin account, even though this backend is otherwise standalone.
ARECGIS_API_URL=https://arecgis-api.nbericmmsu.com
ARECGIS_API_KEY=

# Third-party keys, held server-side only.
OPENCAGE_API_KEY=
GROQ_API_KEY=
NREL_API_KEY=
